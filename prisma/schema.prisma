// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GroupRole {
  LEADER
  ASSISTANT
  ACCOUNTANT
  MEMBER
}

enum ContributionType {
  TARGETED
  OPEN
}

enum ContributionStatus {
  OPEN
  CLOSED
}

enum ExpenseType {
  HANDOVER
  MEMBER_SUPPORT
  LEISURE
  OTHER
}

model Member {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  role      GroupRole?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  assignments ContributionAssignment[]
  payments    Payment[]
  expensesFor Expense[]
  user        User?
}

model Contribution {
  id           String             @id @default(cuid())
  title        String
  description  String?
  type         ContributionType
  targetAmount Decimal?
  deadline     DateTime?
  status       ContributionStatus @default(OPEN)
  createdAt    DateTime           @default(now())

  assignments  ContributionAssignment[]
  payments     Payment[]
  expenses     Expense[]
}

model ContributionAssignment {
  id             String  @id @default(cuid())
  contributionId String
  memberId       String
  requiredAmount Decimal

  contribution   Contribution @relation(fields: [contributionId], references: [id])
  member         Member       @relation(fields: [memberId], references: [id])

  @@unique([contributionId, memberId])
}

model Payment {
  id             String   @id @default(cuid())
  contributionId String
  memberId       String
  amount         Decimal
  paidAt         DateTime @default(now())
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contribution   Contribution @relation(fields: [contributionId], references: [id])
  member         Member       @relation(fields: [memberId], references: [id])
}

model Expense {
  id                String      @id @default(cuid())
  contributionId    String?
  type              ExpenseType
  amount            Decimal
  recipientMemberId String?
  description       String?
  spentAt           DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  contribution      Contribution? @relation(fields: [contributionId], references: [id])
  recipientMember   Member?       @relation(fields: [recipientMemberId], references: [id])
}

model User {
  id           String   @id @default(cuid())
  memberId     String?  @unique
  name         String
  phone        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  member       Member?  @relation(fields: [memberId], references: [id])
  permissions  UserPermission[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  users       UserPermission[]
}

model UserPermission {
  userId       String
  permissionId String

  user         User       @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
}
